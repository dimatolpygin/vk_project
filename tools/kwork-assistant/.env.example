CHROMIUM_EXECUTABLE_PATH=C:\Users\GigaChat\AppData\Local\ms-playwright\chromium-1208\chrome-win64\chrome.exe
KWORK_USER_DATA_DIR=.\profile
KWORK_INBOX_URL=https://kwork.ru/inbox
KWORK_LOGIN_URL=https://kwork.ru/login
KWORK_HEADLESS=false
KWORK_POLL_MS=60000
KWORK_MAX_THREADS_PER_RUN=3

# Tune these after the first real Kwork page inspection if needed.
KWORK_THREAD_LINK_SELECTOR=a[href*="/inbox"], a[href*="/orders"], a[href*="/projects"]
KWORK_MESSAGE_ROOT_SELECTOR=main, body
KWORK_REPLY_FIELD_SELECTOR=textarea, [contenteditable="true"]
KWORK_SEND_BUTTON_SELECTOR=
KWORK_AUTO_SEND=true
KWORK_AUTOPRIME_ON_FIRST_RUN=true

# pi | openai | auto
AI_ENGINE=pi
PI_COMMAND=pi
PI_ARGS=--mode rpc --no-session
PI_TIMEOUT_MS=240000

# Optional OpenAI-compatible fallback. Works with OpenAI, OpenRouter, local gateways, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Telegram notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
